# Normalize text to LF in the repo. Checkout uses the OS native ending
# (CRLF on Windows, LF on Linux/macOS). Commit always stores LF.
* text=auto

# Shell scripts run under sh: keep LF on checkout.
.githooks/* text eol=lf
*.sh text eol=lf
gradlew text eol=lf

# cmd.exe needs CRLF.
*.bat text eol=crlf
